# Environment variables (never commit the real values)

# Required — from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# To see real coupon banners ("70% OFF UPTO ₹140"): your own logged-in session.
# sid cookie value — or the full "sid=...; aws-waf-token=..." Cookie header
SWIGGY_SID=
SWIGGY_USER_ID=

# Distance filter in km (default 7)
SWIGGY_MAX_KM=7

# Optional default location so /coupons works before speaking to the bot
SWIGGY_LAT=
SWIGGY_LNG=
